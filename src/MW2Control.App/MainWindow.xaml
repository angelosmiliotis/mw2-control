<Window x:Class="MW2Control.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MW2Control.App"
 Title="MW2 Control" Width="1360" Height="880" MinWidth="1100" MinHeight="730" Background="#10150F" Foreground="#F3F2E9" FontFamily="Segoe UI" FontSize="14" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Icon="Assets/MW2Control.ico" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
   <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="6" NonClientFrameEdges="None" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Grid x:Name="DesignRoot" ClipToBounds="True" Background="#10150F" SizeChanged="RootSizeChanged">
   <Image Source="Assets/field-art.png" Stretch="UniformToFill" Opacity="0.74" />
   <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#2510190D" /><GradientStop Color="#7010160F" Offset="0.53" /><GradientStop Color="#F00D120D" Offset="1" /></LinearGradientBrush></Rectangle.Fill></Rectangle>
   <Grid x:Name="LayoutSurface">
    <Grid.LayoutTransform><ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1" /></Grid.LayoutTransform>
    <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="72" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border Background="#ED11170F" BorderBrush="#4A513A" BorderThickness="0,0,0,1" MouseLeftButtonDown="DragHeader">
     <Grid Margin="27,0,15,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <Grid Width="43" Height="43" Margin="0,0,13,0"><Ellipse Stroke="#758B50" StrokeThickness="1" Margin="6" /><Line X1="21" Y1="0" X2="21" Y2="12" Stroke="#B3D981" /><Line X1="21" Y1="31" X2="21" Y2="43" Stroke="#B3D981" /><Line X1="0" Y1="21" X2="12" Y2="21" Stroke="#B3D981" /><Line X1="31" Y1="21" X2="43" Y2="21" Stroke="#B3D981" /><Ellipse Width="4" Height="4" Fill="#B3D981" /></Grid>
       <TextBlock FontSize="29" FontWeight="Bold" VerticalAlignment="Center"><Run Text="MW" /><Run Text="2" Foreground="#B7D98C" /><Run Text=" Control" FontSize="24" FontWeight="SemiBold" /></TextBlock>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="27,0"><TextBlock Text="MODERN WARFARE 2" FontSize="10" Foreground="#C3C6B5" /><TextBlock Text="2009 / STEAM EDITION" FontSize="9" Foreground="#929B83" Margin="0,4,0,0" /></StackPanel>
      <Border Grid.Column="2" BorderBrush="#637A47" Background="#253A4623" BorderThickness="1" CornerRadius="15" Padding="14,7" VerticalAlignment="Center" Margin="0,0,23,0"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#ABC580" Margin="0,0,8,0" /><TextBlock Text="{Binding StateLabel}" FontSize="10" Foreground="#C5D6AC" /></StackPanel></Border>
      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="−" Style="{StaticResource Chrome}" Click="MinimizeWindow" AutomationProperties.Name="Minimize" /><Button Content="□" Style="{StaticResource Chrome}" Click="MaximizeWindow" AutomationProperties.Name="Maximize or restore" /><Button Content="×" Style="{StaticResource Chrome}" Click="CloseWindow" AutomationProperties.Name="Close demo" /></StackPanel>
     </Grid>
    </Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <Border BorderBrush="#50583C" BorderThickness="0,0,1,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0D10160E" /><GradientStop Color="#D011180E" Offset="0.4" /><GradientStop Color="#C012190E" Offset="1" /></LinearGradientBrush></Border.Background>
      <Grid><Grid.RowDefinitions><RowDefinition Height="190" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="130" /></Grid.RowDefinitions>
       <StackPanel VerticalAlignment="Bottom" Margin="28,0,0,18"><TextBlock Text="PERSONAL FIELD KIT" FontSize="9" Foreground="#C7C7AC" /><Rectangle Width="30" Height="2" Fill="#B4CF7A" HorizontalAlignment="Left" Margin="0,10,0,0" /></StackPanel>
       <StackPanel Grid.Row="1"><RadioButton x:Name="SettingsNav" Content="Game settings" Tag="&#xE713;" GroupName="Navigation" Style="{StaticResource Nav}" IsChecked="True" Checked="Navigate" /><RadioButton x:Name="DiagnosticsNav" Content="Diagnostics" Tag="&#xE9D9;" GroupName="Navigation" Style="{StaticResource Nav}" Checked="Navigate" /><RadioButton x:Name="NetworkNav" Content="Lobby network" Tag="&#xE968;" GroupName="Navigation" Style="{StaticResource Nav}" Checked="Navigate" /></StackPanel>
       <StackPanel Grid.Row="3" Margin="28,0,24,30" VerticalAlignment="Bottom"><TextBlock Text="BUILT AROUND YOUR GAME." FontSize="9" Foreground="#B9BCA5" /><TextBlock Text="MW2 CONTROL" FontSize="19" FontWeight="Bold" Margin="0,7,0,0" /><TextBlock Text="{Binding AppVersion}" FontSize="9" Foreground="#879478" Margin="0,8,0,0" /></StackPanel>
      </Grid>
     </Border>
     <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition x:Name="FooterRow" Height="80" /></Grid.RowDefinitions>
      <Grid x:Name="SettingsPage" Margin="28,22,28,20">
       <Grid.RowDefinitions><RowDefinition x:Name="SettingsHeadingRow" Height="88" /><RowDefinition Height="1*" MinHeight="155" /><RowDefinition x:Name="FirstGap" Height="18" /><RowDefinition Height="1.1*" MinHeight="190" /><RowDefinition x:Name="SecondGap" Height="18" /><RowDefinition Height="0.64*" MinHeight="100" /></Grid.RowDefinitions>
       <StackPanel VerticalAlignment="Top"><TextBlock Text="THE ESSENTIALS, IN ONE PLACE" Style="{StaticResource Eyebrow}" Foreground="#C5D4AC" /><TextBlock Text="Game settings" FontSize="33" FontWeight="SemiBold" Margin="-1,5,0,4" /><TextBlock Text="Your view. Your pace. Your way to play." Foreground="#C0C4B2" FontSize="13" /></StackPanel>
       <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" BorderBrush="#6B8050"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE81D;" Style="{StaticResource Icon}" Margin="0,0,12,0" /><TextBlock Text="Field of view" FontSize="16" FontWeight="SemiBold" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Value, ElementName=FovSlider, StringFormat={}{0:0}°}" FontSize="35" FontWeight="Light" Foreground="#CCE5A9" /></Grid>
         <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,5"><Slider x:Name="FovSlider" Minimum="65" Maximum="100" Value="{Binding RequestedFov, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding InputsEnabled}" AutomationProperties.Name="Field of view" /><Grid Margin="0,1,0,0"><TextBlock Text="65°" Style="{StaticResource Eyebrow}" /><TextBlock Text="100°" Style="{StaticResource Eyebrow}" HorizontalAlignment="Right" /></Grid></StackPanel>
         <StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="80°" Tag="80" CommandParameter="fov" Click="FovPreset" IsEnabled="{Binding InputsEnabled}" Style="{StaticResource Chip}" Margin="0,0,7,0" /><Button Content="90°" Tag="90" CommandParameter="fov" Click="FovPreset" IsEnabled="{Binding InputsEnabled}" Style="{StaticResource Chip}" Margin="0,0,7,0" /><Button Content="100°" Tag="100" CommandParameter="fov" Click="FovPreset" IsEnabled="{Binding InputsEnabled}" Style="{StaticResource Chip}" Margin="0,0,7,0" /></StackPanel>
        </Grid></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" Foreground="#CFBB84" Margin="0,0,12,0" /><TextBlock Text="Frame cap" FontSize="16" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="FpsValue" Text="{Binding RequestedFpsDisplay}" FontSize="35" FontWeight="Light" Foreground="#E0CB95" /><TextBlock Text="FPS" Style="{StaticResource Eyebrow}" VerticalAlignment="Bottom" Margin="6,0,0,8" /></StackPanel></Grid>
         <Slider Grid.Row="1" x:Name="FpsSlider" Minimum="30" Maximum="500" Value="{Binding RequestedFps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding FpsSliderEnabled}" AutomationProperties.Name="FPS cap" VerticalAlignment="Center" Margin="0,5,0,0" />
         <DockPanel Grid.Row="2"><CheckBox x:Name="Uncapped" Content="Uncapped" Style="{StaticResource Switch}" DockPanel.Dock="Right" Width="125" Padding="0,0" IsChecked="{Binding UncappedFps}" IsEnabled="{Binding InputsEnabled}" Margin="12,0,0,0" /><StackPanel Orientation="Horizontal"><Button Content="144" Tag="144" Click="FpsPreset" IsEnabled="{Binding InputsEnabled}" Style="{StaticResource Chip}" Margin="0,0,7,0" /><Button Content="240" Tag="240" Click="FpsPreset" IsEnabled="{Binding InputsEnabled}" Style="{StaticResource Chip}" Margin="0,0,7,0" /><Button Content="333" Tag="333" Click="FpsPreset" IsEnabled="{Binding InputsEnabled}" Style="{StaticResource Chip}" /></StackPanel></DockPanel>
        </Grid></Border>
       </Grid>
       <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="18,16"><Grid><Grid.RowDefinitions><RowDefinition Height="31" /><RowDefinition Height="*" /></Grid.RowDefinitions>
         <DockPanel><TextBlock Text="&#xE790;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,10,0" /><TextBlock Text="Visuals" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
         <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource VisualTile}"><CheckBox x:Name="Fullbright" Style="{StaticResource VisualSwitch}" Checked="SettingsChanged" Unchecked="SettingsChanged" IsChecked="{Binding Fullbright.Requested, Mode=TwoWay}" IsEnabled="{Binding Fullbright.Editable}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE706;" Style="{StaticResource TileIcon}" /><TextBlock Text="Fullbright" /></StackPanel></CheckBox></Border>
          <Border Grid.Column="2" Style="{StaticResource VisualTile}"><CheckBox x:Name="NoFog" Style="{StaticResource VisualSwitch}" Checked="SettingsChanged" Unchecked="SettingsChanged" IsChecked="{Binding Fog.Requested, Mode=TwoWay}" IsEnabled="{Binding Fog.Editable}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE753;" Style="{StaticResource TileIcon}" /><TextBlock Text="No fog" /></StackPanel></CheckBox></Border>
          <Border Grid.Row="2" Style="{StaticResource VisualTile}"><CheckBox x:Name="NoGlow" Style="{StaticResource VisualSwitch}" Checked="SettingsChanged" Unchecked="SettingsChanged" IsChecked="{Binding Glow.Requested, Mode=TwoWay}" IsEnabled="{Binding Glow.Editable}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE734;" Style="{StaticResource TileIcon}" /><TextBlock Text="No glow" /></StackPanel></CheckBox></Border>
          <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource VisualTile}"><CheckBox x:Name="NoDetail" Style="{StaticResource VisualSwitch}" Checked="SettingsChanged" Unchecked="SettingsChanged" IsChecked="{Binding Detail.Requested, Mode=TwoWay}" IsEnabled="{Binding Detail.Editable}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81E;" Style="{StaticResource TileIcon}" /><TextBlock Text="No detail overlays" FontSize="12" /></StackPanel></CheckBox></Border>
         </Grid>
        </Grid></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18"><StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="17" Margin="0,0,10,0" /><TextBlock Text="Specular mode" FontSize="16" FontWeight="SemiBold" /></StackPanel><TextBlock Text="Reflections and highlights" Style="{StaticResource Caption}" Margin="0,8,0,16" /><ComboBox x:Name="Specular" HorizontalAlignment="Stretch" ItemsSource="{Binding SpecularChoices}" SelectedIndex="{Binding SpecularChoice, Mode=TwoWay}" IsEnabled="{Binding SpecularEditable}" AutomationProperties.Name="Specular mode" /></StackPanel></Border>
       </Grid>
       <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}"><Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE74F;" Style="{StaticResource Icon}" FontSize="22" /><StackPanel Grid.Column="1"><CheckBox x:Name="StreamMute" Content="Mute streamed sounds" Style="{StaticResource Switch}" Padding="0,0" Checked="SettingsChanged" Unchecked="SettingsChanged" IsChecked="{Binding Music.Requested, Mode=TwoWay}" IsEnabled="{Binding Music.Editable}" /><TextBlock Text="Less background noise. Keep the game cues." Style="{StaticResource Caption}" Margin="0,9,0,0" /></StackPanel></Grid></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}"><Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="22" /><StackPanel Grid.Column="1"><CheckBox x:Name="NumericPing" Content="Numeric ping" Style="{StaticResource Switch}" Padding="0,0" Checked="SettingsChanged" Unchecked="SettingsChanged" IsChecked="{Binding Ping.Requested, Mode=TwoWay}" IsEnabled="{Binding Ping.Editable}" /><TextBlock Text="Actual milliseconds, straight on the scoreboard." Style="{StaticResource Caption}" Margin="0,9,0,0" /></StackPanel></Grid></Border>
       </Grid>
      </Grid>
      <ScrollViewer x:Name="DiagnosticsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,22,28,22">
       <TextBlock Text="UNDER THE HOOD" Style="{StaticResource Eyebrow}" /><TextBlock Text="Diagnostics" FontSize="33" FontWeight="SemiBold" Margin="0,6,0,6" /><TextBlock Text="Connection details, current readings and recent actions." Style="{StaticResource Caption}" Margin="0,0,0,22" />
       <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
        <DockPanel><Button Content="Scan session" Command="{Binding ScanCommand}" DockPanel.Dock="Right" HorizontalAlignment="Right" /><StackPanel><TextBlock Text="{Binding SessionTitle}" FontSize="21" Foreground="{StaticResource Accent}" /><TextBlock Text="{Binding SessionDetail}" Style="{StaticResource Caption}" Margin="0,8,18,0" /></StackPanel></DockPanel>
        <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="EXECUTABLE" Style="{StaticResource Eyebrow}" /><TextBlock Text="{Binding ProcessName}" FontSize="18" Margin="0,6,0,0" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="PROCESS ID" Style="{StaticResource Eyebrow}" /><TextBlock Text="{Binding ProcessId}" FontSize="18" Margin="0,6,0,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="CONNECTION" Style="{StaticResource Eyebrow}" /><TextBlock Text="{Binding StateLabel}" FontSize="13" Foreground="{StaticResource Accent}" Margin="0,8,0,0" /></StackPanel></Grid>
        <Expander Header="Build fingerprint and executable path" Margin="0,17,0,0" Foreground="{StaticResource MutedBrush}"><StackPanel Margin="0,12,0,0"><TextBlock Text="{Binding Fingerprint}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding GamePath}" Style="{StaticResource Caption}" Margin="0,8,0,0" /></StackPanel></Expander>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,0,0,18"><Expander Header="Current settings" Foreground="{StaticResource Ink}"><StackPanel><TextBlock Text="Readings appear when a compatible game is connected." Style="{StaticResource Caption}" Margin="0,8,0,0" /><ItemsControl ItemsSource="{Binding Features}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0"><StackPanel><DockPanel><TextBlock Text="{Binding ObservedValue, TargetNullValue=—}" Foreground="{StaticResource Accent}" DockPanel.Dock="Right" HorizontalAlignment="Right" /><TextBlock Text="{Binding Label}" FontWeight="SemiBold" /></DockPanel><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Expander></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Recent activity" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" /><ItemsControl ItemsSource="{Binding Activity}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}" FontSize="12" LineHeight="22" Margin="0,4,0,4" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
      </StackPanel></ScrollViewer>
      <ContentControl x:Name="NetworkPage" Visibility="Collapsed" />
      <Border Grid.Row="1" Background="#F0141B12" BorderBrush="#4E5B3B" BorderThickness="0,1,0,0" Padding="32,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="Status" Text="{Binding MaintenanceStatus}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding MaintenanceStatus}" FontSize="13" FontWeight="SemiBold" /><TextBlock x:Name="StatusHint" Text="{Binding LastResult}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding LastResult}" Foreground="#929F80" FontSize="10" Margin="0,6,0,0" /></StackPanel><Button Grid.Column="1" Content="↶   Reset" Command="{Binding ResetCommand}" Padding="22,13" Margin="0,0,12,0" /><Button Grid.Column="2" x:Name="ApplyButton" Content="✓   Apply settings" Command="{Binding ApplyCommand}" Style="{StaticResource Primary}" /></Grid></Border>
     </Grid>
    </Grid>
   </Grid>
   <Border BorderBrush="#53613F" BorderThickness="1" IsHitTestVisible="False" />
  </Grid>
</Window>
