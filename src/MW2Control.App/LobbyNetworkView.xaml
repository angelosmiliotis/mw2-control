<UserControl x:Class="MW2Control.App.LobbyNetworkView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Margin="32,27,32,32">
  <TextBlock Text="LOBBY / PASSIVE UDP OBSERVATION" Style="{StaticResource Eyebrow}" />
  <TextBlock Text="Lobby Network" Style="{StaticResource PageTitle}" />
  <TextBlock Text="Scan IPv4 lobby traffic to see the busiest observed peer. Relays can make the likely host unreliable." Style="{StaticResource Muted}" Margin="0,0,0,20" />
  <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
   <TextBlock Text="{Binding HostSummary}" FontSize="18" AutomationProperties.LiveSetting="Polite" />
   <WrapPanel Margin="0,14,0,0" IsEnabled="{Binding Idle}">
    <Button Content="Scan lobby" Click="StartCapture" IsEnabled="{Binding CanStart}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10" />
    <Button Content="Block likely host…" Click="BlockPeer" IsEnabled="{Binding CanBlock}" Margin="0,0,10,10" />
    <Button Content="Stop scan" Click="StopCapture" IsEnabled="{Binding Capturing}" Margin="0,0,0,10" />
   </WrapPanel>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
   <TextBlock Text="{Binding ActionResult}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
   <Expander Header="Capture adapter" Foreground="{StaticResource TextBrush}" Margin="0,14,0,0"><StackPanel>
    <TextBlock Text="Choose an adapter if automatic selection is ambiguous or the scan sees no lobby traffic. Npcap is required." Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
    <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="Label" IsEnabled="{Binding CanChooseAdapter}" Padding="8" Margin="0,8,0,8" AutomationProperties.Name="Capture adapter" />
    <Button Content="Refresh adapters" Click="RefreshAdapters" IsEnabled="{Binding CanChooseAdapter}" HorizontalAlignment="Left" />
   </StackPanel></Expander>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><Expander Header="App-owned firewall blocks" Foreground="{StaticResource TextBrush}"><StackPanel>
   <TextBlock Text="Exact public IP rules scoped to iw4mp.exe and UDP. Blocking may disconnect you and affect other lobbies using the same IP or relay. Host IPs can change. Administrator permissions may be required." Foreground="{StaticResource AmberBrush}" FontSize="12" Margin="0,8,0,12" />
   <ListBox ItemsSource="{Binding Blocks}" SelectedItem="{Binding SelectedBlock}" Background="#171910" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" MinHeight="72" MaxHeight="220" HorizontalContentAlignment="Stretch" AutomationProperties.Name="App-owned firewall rules"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Address}" FontWeight="SemiBold" /><TextBlock Text="{Binding GamePath}" FontSize="12" /><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   <WrapPanel Margin="0,14,0,0"><Button Content="Refresh owned blocks" Click="RefreshBlocks" IsEnabled="{Binding Idle}" Margin="0,0,10,10" /><Button Content="Unblock selected IP…" Click="UnblockPeer" IsEnabled="{Binding CanUnblock}" Margin="0,0,0,10" /></WrapPanel>
  </StackPanel></Expander></Border>
 </StackPanel></ScrollViewer>
</UserControl>
